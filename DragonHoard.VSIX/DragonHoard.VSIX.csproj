<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Enable WPF APIs (PresentationFramework.MessageBox) used by the extension -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.0" PrivateAssets="all"/>
  </ItemGroup>
  <ItemGroup>
    <!-- Assembly references that are provided by Visual Studio at build/runtime -->
    <Reference Include="EnvDTE" />
    <Reference Include="EnvDTE80" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <!-- Use WebView2 for modern rendering inside the tool window -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1343.22" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ensure manifest and command table and resources are included in the VSIX output -->
    <None Include="source.extension.vsixmanifest">
      <Pack>true</Pack>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="Commands.vsct">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\KoboldIcon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
