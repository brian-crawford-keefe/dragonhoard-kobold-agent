<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="DragonHoard.Kobold.Extension" Version="1.0.0.0" Language="en-US" Publisher="Dragon" />
    <DisplayName>Kobold Chat Agent</DisplayName>
    <Description xml:space="preserve">Summon Pip, your AI kobold guide inside Visual Studio. Provides an editor-integrated summary tool backed by a local KoboldBrain service.</Description>
    <MoreInfoUrl>https://example.local/dragonhoard</MoreInfoUrl>
    <Tags>AI;Assistant;Kobold;Code</Tags>
  </Metadata>

  <!-- Install into Visual Studio 2022+ (v17) -->
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio" Version="[17.0,18.0)" />
  </Installation>

  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,18.0)" />
  </Prerequisites>

  <Assets>
    <!-- Command table (vsct) enabling menu/toolbar commands -->
    <Asset Type="Microsoft.VisualStudio.Vsct" Path="Commands.vsct" />
    <!-- The main assembly produced by the VSIX project; the pack process will replace the DLL name -->
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="DragonHoard.VSIX.dll" />
    <!-- Icon shown in the VSIX gallery and installer -->
    <Asset Type="Microsoft.VisualStudio.Icon" Path="Resources\KoboldIcon.png" Visible="true" />
    <!-- The manifest itself (keeps the file in the package) -->
    <Asset Type="Microsoft.VisualStudio.VsixManifest" Path="source.extension.vsixmanifest" />
  </Assets>

  <Dependencies>
    <!-- If you depend on specific VS components, enumerate them here -->
    <Dependency Id="Microsoft.VisualStudio.MPF.15.0" DisplayName="Visual Studio MPF 15.0" Version="15.0" />
  </Dependencies>
</PackageManifest>
